+package com.example.client;
+
+import com.example.CarEntity;
+import net.minecraft.client.renderer.entity.EntityRendererProvider;
+import net.minecraft.client.renderer.entity.MobRenderer;
+import net.minecraft.util.Identifier;
+
+public class CarEntityRenderer extends MobRenderer<CarEntity, CarEntityModel> {
+    private static final Identifier TEXTURE = Identifier.of("jeskocar", "textures/entity/car.png");
+
+    public CarEntityRenderer(EntityRendererProvider.Context context) {
+        super(context, new CarEntityModel(context.bakeLayer(ExampleModClient.MODEL_CAR_LAYER)), 1.5f);
+    }
+
+    @Override
+    public Identifier getTextureLocation(CarEntity entity) {
+        return TEXTURE;
+    }
+}
