+package com.example.client;
+
+import com.example.CarEntity;
+import net.minecraft.client.model.EntityModel;
+import net.minecraft.client.model.geom.ModelPart;
+import net.minecraft.client.model.geom.PartPose;
+import net.minecraft.client.model.geom.builders.CubeListBuilder;
+import net.minecraft.client.model.geom.builders.LayerDefinition;
+import net.minecraft.client.model.geom.builders.MeshDefinition;
+import net.minecraft.client.model.geom.builders.PartDefinition;
+import com.mojang.blaze3d.vertex.PoseStack;
+import com.mojang.blaze3d.vertex.VertexConsumer;
+
+public class CarEntityModel extends EntityModel<CarEntity> {
+    private final ModelPart root;
+
+    public CarEntityModel(ModelPart root) {
+        this.root = root.getChild("root");
+    }
+
+    public static LayerDefinition getTexturedModelData() {
+        MeshDefinition meshdefinition = new MeshDefinition();
+        PartDefinition partdefinition = meshdefinition.getRoot();
+
+        PartDefinition rootPart = partdefinition.addOrReplaceChild("root", CubeListBuilder.create(), PartPose.offset(0.0F, 24.0F, 0.0F));
+        rootPart.addOrReplaceChild("chassis", CubeListBuilder.create().texOffs(0, 0).addBox(-16.0F, -8.0F, -24.0F, 32.0F, 6.0F, 48.0F), PartPose.offset(0.0F, 0.0F, 0.0F));
+        rootPart.addOrReplaceChild("cabin", CubeListBuilder.create().texOffs(0, 54).addBox(-12.0F, -14.0F, -10.0F, 24.0F, 6.0F, 20.0F), PartPose.offset(0.0F, 0.0F, 0.0F));
+        rootPart.addOrReplaceChild("spoiler", CubeListBuilder.create().texOffs(0, 80).addBox(-15.0F, -18.0F, 20.0F, 30.0F, 2.0F, 8.0F), PartPose.offset(0.0F, 0.0F, 0.0F));
+        rootPart.addOrReplaceChild("spoiler_strut_left", CubeListBuilder.create().texOffs(80, 80).addBox(10.0F, -16.0F, 22.0F, 2.0F, 8.0F, 4.0F), PartPose.offset(0.0F, 0.0F, 0.0F));
+        rootPart.addOrReplaceChild("spoiler_strut_right", CubeListBuilder.create().texOffs(80, 80).addBox(-12.0F, -16.0F, 22.0F, 2.0F, 8.0F, 4.0F), PartPose.offset(0.0F, 0.0F, 0.0F));
+        rootPart.addOrReplaceChild("wheel_front_left", CubeListBuilder.create().texOffs(112, 0).addBox(-4.0F, -4.0F, -4.0F, 8.0F, 8.0F, 8.0F), PartPose.offset(-16.0F, -4.0F, -16.0F));
+        rootPart.addOrReplaceChild("wheel_front_right", CubeListBuilder.create().texOffs(112, 0).addBox(-4.0F, -4.0F, -4.0F, 8.0F, 8.0F, 8.0F), PartPose.offset(16.0F, -4.0F, -16.0F));
+        rootPart.addOrReplaceChild("wheel_rear_left", CubeListBuilder.create().texOffs(112, 0).addBox(-4.0F, -4.0F, -4.0F, 8.0F, 8.0F, 8.0F), PartPose.offset(-16.0F, -4.0F, 16.0F));
+        rootPart.addOrReplaceChild("wheel_rear_right", CubeListBuilder.create().texOffs(112, 0).addBox(-4.0F, -4.0F, -4.0F, 8.0F, 8.0F, 8.0F), PartPose.offset(16.0F, -4.0F, 16.0F));
+
+        return LayerDefinition.create(meshdefinition, 256, 128);
+    }
+
+    @Override
+    public void setupAnim(CarEntity entity, float limbSwing, float limbSwingAmount, float ageInTicks, float netHeadYaw, float headPitch) {
+        float wheelSpin = limbSwing * 0.5f;
+        root.getChild("wheel_front_left").xRot = wheelSpin;
+        root.getChild("wheel_front_right").xRot = wheelSpin;
+        root.getChild("wheel_rear_left").xRot = wheelSpin;
+        root.getChild("wheel_rear_right").xRot = wheelSpin;
+    }
+
+    @Override
+    public void renderToBuffer(PoseStack poseStack, VertexConsumer vertexConsumer, int packedLight, int packedOverlay, int color) {
+        root.render(poseStack, vertexConsumer, packedLight, packedOverlay, color);
+    }
+}
